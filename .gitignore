# Ignore everything by default
*

# But allow these files and directories
!.gitignore
!AGENTS.md
!AGENTSxx.md
!WAOSPlan.md
!WAOSPlan.md
!README.md
!Initial-blue-print.md
!client-fingerprinting-comparison.md
!reverse-engineered-waweb-findings.md
!Reverse-Engineered-whatsapp-web-status_protocol.md
!Reverse-Engineered-whatsapp-web-status_sending_protocol.md


# Allow source code directory
#!src/
#!src/**

# Allow waos project, but still ignore its build and dependencies
!waos/
!waos/**
waos/target/
waos/**/node_modules/
waos/**/dist/
# Allow only whatsapp-rust/wacore and its files
!xwhatsapp-rust/**
!xwhatsapp-rust/wacore/
!xwhatsapp-rust/wacore/**

# Allow zerowrapper project, but still ignore its build and dependencies
!zerowrapper/
!zerowrapper/**
zerowrapper/target/
zerowrapper/**/node_modules/
zerowrapper/**/dist/
!docs/
!docs/**
