---
import settings from '../data/sitesettings.json' assert { type: 'json' };
---

<footer
  class="flex flex-col sm:flex-row"
  style="border-top: 1px solid var(--color-border-weak);"
>
  <div class="flex-1 text-center">
    <a
      href={settings.site.url}
      target="_blank"
      rel="noopener"
      class="block no-underline py-3 sm:py-4 text-xs transition"
      style="color: var(--color-text-weak);"
    >{settings.footer.text}</a>
  </div>
  {settings.footer.links.map((link) => (
    <div class="flex-1 text-center sm:border-l" style="border-color: var(--color-border-weak);">
      <a
        href={link.url}
        target="_blank"
        rel="noopener"
        class="block no-underline py-3 sm:py-4 text-xs transition"
        style="color: var(--color-text-weak);"
      >{link.label}</a>
    </div>
  ))}
</footer>

<style>
  footer a:hover { background: var(--color-bg-weak); text-decoration: underline; }
  @media (max-width: 40rem) { footer .sm\\:border-l { border-left: none !important; } }
</style>
