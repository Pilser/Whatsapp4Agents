---
import landing from '../../data/landing.json' assert { type: 'json' };
const { examples } = landing;
---
<div id="example-chips" class="flex flex-wrap gap-2 mb-6">
  {examples.map((ex) => (
    <button
      class="example-chip px-1.5 py-0.5 text-[10px] leading-none rounded-sm cursor-pointer transition"
      style="background: var(--color-bg-weak); color: var(--color-text-weak);"
      data-query={ex.query}
    >{ex.query}</button>
  ))}
</div>

<style>
  .example-chip:hover { background: var(--color-bg-weak-hover) !important; color: var(--color-text) !important; }
</style>
