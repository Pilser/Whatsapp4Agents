<form id="chat-form" style="padding-top: 8px;">
  <div class="relative">
    <textarea
      id="chat-input"
      placeholder="Type your message here..."
      rows="2"
      class="w-full px-5 py-3.5 pr-12 text-sm rounded-xl resize-none outline-none transition leading-relaxed"
      style="min-height: 52px; max-height: 160px; border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono);"
    ></textarea>
    <button
      type="submit"
      id="send-btn"
      class="absolute bottom-2 right-2 z-10 flex items-center justify-center cursor-pointer transition rounded-lg"
      style="width: 32px; height: 32px; border: none; background: var(--color-bg-interactive); color: var(--color-text-inverted);"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
    <button
      type="button"
      id="cancel-btn"
      class="absolute bottom-2 right-2 z-10 hidden items-center justify-center cursor-pointer transition rounded-lg"
      style="width: 32px; height: 32px; border: none; background: var(--color-status-error); color: #fff;"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
    </button>
  </div>
</form>

<style>
  #chat-input:focus { border-color: var(--color-bg-interactive) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-bg-interactive) 30%, transparent) !important; }
  #chat-input::placeholder { color: var(--color-text-weak); opacity: 0.7; }
  #chat-form { flex-shrink: 0; }
  #send-btn:hover { opacity: 0.85; }
  #cancel-btn:hover { opacity: 0.85; }
</style>
