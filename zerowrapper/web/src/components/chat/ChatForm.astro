<form id="chat-form" class="flex flex-col sm:flex-row gap-3" style="padding-top: 8px;">
  <textarea
    id="chat-input"
    placeholder="Type your message here..."
    rows="2"
    class="flex-1 px-5 py-3.5 text-sm rounded-xl resize-none outline-none transition leading-relaxed"
    style="min-height: 52px; max-height: 160px; border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono);"
  ></textarea>
  <button
    type="submit"
    id="send-btn"
    class="px-5 py-3.5 sm:px-6 sm:self-stretch text-sm font-medium rounded-xl cursor-pointer whitespace-nowrap transition flex items-center justify-center gap-2"
  >
    <span class="hidden sm:inline">Send</span>
    <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
  </button>
</form>

<style>
  #chat-input:focus { border-color: var(--color-bg-interactive) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-bg-interactive) 30%, transparent) !important; }
  #chat-input::placeholder { color: var(--color-text-weak); opacity: 0.7; }
  #chat-form { flex-shrink: 0; }
  #send-btn { background: var(--color-bg-interactive); color: var(--color-text-inverted); border: none; }
  #send-btn:hover { background: var(--color-bg-interactive-weak) !important; color: var(--color-text-strong) !important; }
  @media (prefers-color-scheme: dark) {
    #send-btn { background: var(--color-bg-interactive-weak); color: var(--color-text-strong); }
    #send-btn:hover { background: var(--color-bg-interactive) !important; color: var(--color-text-inverted) !important; }
  }
</style>
