---
import landing from '../data/landing.json' assert { type: 'json' };
const { hero } = landing;
---

<section class="px-6 py-4 md:py-6 md:px-10">
  <h1 class="text-xl md:text-2xl font-bold mb-1" style="color: var(--color-text-strong);">
    {hero.title}
  </h1>
  <p class="text-sm w-full leading-relaxed" style="color: var(--color-text);">
    {hero.description}
  </p>
</section>
