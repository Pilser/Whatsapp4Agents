---
import ChatHeader from './chat/ChatHeader.astro'
import ExampleChips from './chat/ExampleChips.astro'
import ChatMessages from './chat/ChatMessages.astro'
import TypingIndicator from './chat/TypingIndicator.astro'
import AuthSection from './chat/AuthSection.astro'
import UserBadge from './chat/UserBadge.astro'
import ChatForm from './chat/ChatForm.astro'
import landing from '../data/landing.json' assert { type: 'json' };
const { hero } = landing;
---

<section
  class="px-6 py-8 md:px-10 mb-2 md:mb-4"
  id="chat"
  style="border-top: 1px solid var(--color-border-weak);"
>
  <ChatHeader />
  <ExampleChips />
  <ChatMessages />
  <TypingIndicator />

  <div id="chat-bottom-bar" style="position: sticky; bottom: 0; z-index: 10; background: var(--color-bg); padding-top: 12px; margin-top: 8px;">
    <AuthSection />
    <UserBadge />
    <ChatForm />
  </div>

  <section class="pt-6 pb-2" style="margin-top: 24px;">
    <h1 class="text-xl md:text-2xl font-bold mb-1" style="color: var(--color-text-strong);">{hero.title}</h1>
    <p class="text-sm w-full leading-relaxed" style="color: var(--color-text);">{hero.description}</p>
  </section>

  <section id="faq-below" class="pt-6 pb-2" style="border-top: 1px solid var(--color-border-weak); margin-top: 24px;">
    <h3 class="text-sm font-bold mb-4" style="color: var(--color-text-strong);">FAQ</h3>
    <ul class="list-none p-0 m-0">
      {landing.faq.map((item) => (
        <li class="leading-relaxed" style="border-top: 1px solid var(--color-border-weak); padding: 10px 0;">
          <details class="faq-item group">
            <summary class="flex items-start gap-3 mb-1 font-medium cursor-pointer text-sm list-none" style="color: var(--color-text-strong);">
              <span class="faq-icon flex-shrink-0" style="color: var(--color-text-weak);">[+]</span>
              {item.q}
            </summary>
            <div class="ml-9 pb-2 text-sm leading-relaxed" style="color: var(--color-text);">{item.a}</div>
          </details>
        </li>
      ))}
    </ul>
  </section>

<style>
  :global(#chat-messages > .message-row) { display: flex; flex-direction: column; margin-bottom: 16px; animation: msg-slide-in 0.2s ease-out; }
  @keyframes msg-slide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  :global(#chat-messages > .message-row.user) { align-items: flex-end; }
  :global(#chat-messages > .message-row.assistant) { align-items: flex-start; }
  :global(#chat-messages > .message-row .msg-avatar) { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  :global(#chat-messages > .message-row.user .msg-avatar) { background: var(--color-bg-interactive); border: 1px solid var(--color-border-weak); }
  :global(#chat-messages > .message-row.assistant .msg-avatar) { background: var(--color-bg-weak); border: 1px solid var(--color-border-weak); }
  :global(#chat-messages > .message-row .msg-avatar svg) { width: 12px; height: 12px; }
  :global(#chat-messages > .message-row.user .msg-avatar svg) { stroke: var(--color-text-inverted); }
  :global(#chat-messages > .message-row.assistant .msg-avatar svg) { stroke: var(--color-text-weak); }
  :global(#chat-messages > .message-row .msg-content) { padding: 12px 16px; font-size: 0.875rem; line-height: 1.75; word-wrap: break-word; border-radius: 10px; width: 100%; box-sizing: border-box; }
  :global(#chat-messages > .message-row.user .msg-content) { border: 1px solid var(--color-border-weak); color: var(--color-text-inverted); font-weight: 450; background: var(--color-bg-interactive); border-bottom-right-radius: 4px; max-width: 75%; width: auto; }
  :global(#chat-messages > .message-row.assistant .msg-content) { border: 1px solid var(--color-border-weak); color: var(--color-text); background: var(--color-bg); border-bottom-left-radius: 4px; }
  :global(.chat-markdown) p { margin-bottom: 0.75rem; line-height: 1.75; }
  :global(.chat-markdown) p:last-child { margin-bottom: 0; }
  :global(.chat-markdown) ul, :global(.chat-markdown) ol { margin: 0.5rem 0; padding-left: 1.5rem; line-height: 1.75; }
  :global(.chat-markdown) li { margin-bottom: 0.25rem; }
  :global(.chat-markdown) strong { color: var(--color-text-strong); font-weight: 600; }
  :global(.chat-markdown) em, :global(.chat-markdown) i { font-style: italic; color: var(--color-text); }
  :global(.chat-markdown) u, :global(.chat-markdown) ins { text-decoration: underline; text-underline-offset: 2px; }
  :global(.chat-markdown) del, :global(.chat-markdown) s, :global(.chat-markdown) strike { text-decoration: line-through; color: var(--color-text-weak); }
  :global(.chat-markdown) mark { background: color-mix(in srgb, var(--color-bg-interactive) 25%, transparent); color: var(--color-text-strong); padding: 0 4px; border-radius: 3px; }
  :global(.chat-markdown) q { font-style: italic; }
  :global(.chat-markdown) q::before { content: '\201C'; }
  :global(.chat-markdown) q::after { content: '\201D'; }
  :global(.chat-markdown) kbd { font-family: var(--font-mono); font-size: 0.75rem; padding: 1px 5px; border-radius: 4px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); color: var(--color-text-strong); box-shadow: 0 1px 0 var(--color-border-weak); }
  :global(.chat-markdown) small { font-size: 0.75rem; color: var(--color-text-weak); }
  :global(.chat-markdown) sup { font-size: 0.6875rem; vertical-align: super; }
  :global(.chat-markdown) sub { font-size: 0.6875rem; vertical-align: sub; }
  :global(.chat-markdown) a { color: var(--color-bg-interactive); text-decoration: underline; text-underline-offset: 2px; }
  :global(.chat-markdown) a:hover { opacity: 0.8; }
  :global(.chat-markdown) abbr { text-decoration: underline dotted; text-underline-offset: 2px; cursor: help; }
  :global(.chat-markdown) dl { margin: 0.5rem 0; line-height: 1.75; }
  :global(.chat-markdown) dt { font-weight: 600; color: var(--color-text-strong); }
  :global(.chat-markdown) dd { margin-left: 1.5rem; color: var(--color-text); }
  :global(.chat-markdown) h1, :global(.chat-markdown) h2, :global(.chat-markdown) h3 { color: var(--color-text-strong); font-weight: 600; margin: 1rem 0 0.5rem; }
  :global(.chat-markdown) h1 { font-size: 1.125rem; }
  :global(.chat-markdown) h2 { font-size: 1rem; }
  :global(.chat-markdown) h3 { font-size: 0.9375rem; }
  :global(.chat-markdown) pre { margin: 0.75rem 0; border-radius: 6px; overflow-x: auto; }
  :global(.chat-markdown) pre code { font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.6; }
  :global(.chat-markdown) :not(pre) > code { background: var(--color-bg-weak); padding: 2px 6px; border-radius: 4px; font-size: 0.8125rem; color: var(--color-text-strong); }
  :global(.chat-markdown) blockquote { border-left: 3px solid var(--color-border-weak); padding-left: 1rem; margin: 0.75rem 0; color: var(--color-text-weak); }
  :global(.chat-markdown .table-outer-wrap) { position: relative; margin: 0.75rem 0; }
  :global(.chat-markdown .table-wrap) { overflow-x: auto; }
  :global(.chat-markdown .table-wrap table) { border-collapse: collapse; width: 100%; min-width: 480px; margin: 0; }
  :global(.chat-markdown th), :global(.chat-markdown td) { border: 1.5px solid var(--color-border); padding: 8px 12px; text-align: left; font-size: 0.8125rem; line-height: 1.5; }
  :global(.chat-markdown th) { color: var(--color-text-strong); font-weight: 700; background: var(--color-bg-interactive-weak); white-space: nowrap; }
  :global(.chat-markdown tr:nth-child(even) td) { background: var(--color-bg); }
  :global(.chat-markdown .table-outer-wrap .scroll-fade) {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 48px;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(.chat-markdown .table-outer-wrap .scroll-arrow) {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
    font-size: 0.75rem;
    color: var(--color-text-weak);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
    line-height: 1;
  }
  :global(.chat-markdown .table-outer-wrap.overflow:not(.scrolled-end):not(.scrolling) .scroll-fade),
  :global(.chat-markdown .table-outer-wrap.overflow:not(.scrolled-end):not(.scrolling) .scroll-arrow) {
    opacity: 1;
  }
  :global(.chat-markdown) hr { border: none; border-top: 1px solid var(--color-border-weak); margin: 1rem 0; }
  :global(.thinking-block) { margin-bottom: 4px; }
  :global(.thinking-block details) { margin: 0; }
  :global(.thinking-block summary) { font-size: 0.6875rem; color: var(--color-text-weak); cursor: pointer; user-select: none; display: inline-flex; align-items: center; gap: 4px; padding: 1px 0; }
  :global(.thinking-block summary)::before { content: none; }
  :global(.thinking-block summary .think-icon) { width: 0.75rem; height: 0.75rem; flex-shrink: 0; color: var(--color-bg-interactive); display: inline-block; }
  :global(.thinking-block pre) { font-size: 0.6875rem; color: var(--color-text-weak); background: var(--color-bg-weak); padding: 6px 10px; border-radius: 4px; margin: 4px 0 0; white-space: pre-wrap; word-break: break-word; max-height: 120px; overflow-y: auto; }
  :global(.tool-call-pill) { display: inline-flex; flex-direction: column; margin-bottom: 4px; margin-left: 38px; cursor: pointer; }
  :global(.tool-call-pill .tc-pill-inner) { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 10px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); font-size: 0.6875rem; line-height: 1.4; }
  :global(.tool-call-pill .tc-icon) { width: 0.6875rem; height: 0.6875rem; flex-shrink: 0; color: var(--color-text-weak); display: inline-block; }
  :global(.tool-call-pill .tc-pill-name) { font-family: var(--font-mono); color: var(--color-text-strong); }
  :global(.tool-call-pill .tc-pill-status) { font-size: 0.625rem; }
  :global(.tool-call-pill .tc-pill-status.running) { color: var(--color-status-running); }
  :global(.tool-call-pill .tc-pill-status.done) { color: var(--color-status-success); }
  :global(.tool-call-pill .tc-pill-status.error) { color: var(--color-status-error); }
  :global(.tool-call-pill .tc-pill-detail) { margin-top: 3px; padding: 4px 8px; font-size: 0.6875rem; background: var(--color-bg); border-radius: 4px; border: 1px solid var(--color-border-weak); }
  :global(.tool-call-pill .tc-pill-detail pre) { font-size: 0.6875rem; font-family: var(--font-mono); line-height: 1.5; margin: 0; white-space: pre-wrap; word-break: break-word; }
  :global(.tool-call-pill .tc-pill-detail details) { margin-top: 2px; }
  :global(.tool-call-pill .tc-pill-detail summary) { font-size: 0.6875rem; color: var(--color-text-weak); cursor: pointer; }
  :global(.chat-markdown img) { max-width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--color-border-weak); cursor: pointer; display: block; margin: 0.75rem 0; transition: opacity 0.2s; }
  :global(.chat-markdown img:hover) { opacity: 0.85; }
  :global(.chat-markdown video) { max-width: 100%; border-radius: 8px; border: 1px solid var(--color-border-weak); margin: 0.75rem 0; display: block; }
  :global(.chat-markdown .file-embed) { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); font-size: 0.8125rem; text-decoration: none; margin: 0.375rem 0; color: var(--color-text-strong); transition: background 0.2s; }
  :global(.chat-markdown .file-embed:hover) { background: var(--color-bg-weak-hover); }
  :global(.chat-markdown .file-embed .file-icon) { font-size: 1rem; flex-shrink: 0; }
  :global(.chat-markdown iframe.pdf-embed) { width: 100%; height: 500px; border: 1px solid var(--color-border-weak); border-radius: 8px; margin: 0.75rem 0; }
  #lightbox { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.25s; cursor: zoom-out; }
  #lightbox.active { opacity: 1; pointer-events: auto; }
  #lightbox img { max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,0.5); }
  #lightbox .lb-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.15); color: #fff; border: none; font-size: 1.25rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
  #lightbox .lb-close:hover { background: rgba(255,255,255,0.3); }
  #chat { }
  :global(html) {
    /* SCROLL_PADDING_BOTTOM: last messages scroll above the sticky form bar.
       Increase this if there's still visible gap below the last message. */
    scroll-padding-bottom: 180px;
  }
  summary::marker { content: none; }
  summary::-webkit-details-marker { display: none; }
</style>

<script>
  import { init } from '../js/chat/main.js'
  init()
</script>

<script>
  document.querySelectorAll('.faq-item').forEach(function(d) {
    var icon = d.querySelector('.faq-icon');
    d.addEventListener('toggle', function() {
      if (icon) icon.textContent = d.open ? '[-]' : '[+]';
    });
  });
</script>
