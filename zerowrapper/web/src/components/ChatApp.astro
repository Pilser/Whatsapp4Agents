---
import landing from '../data/landing.json' assert { type: 'json' };
const { hero, examples } = landing;
---

<section
  class="px-6 py-8 md:px-10 mb-2 md:mb-4 flex flex-col"
  id="chat"
  style="border-top: 1px solid var(--color-border-weak);"
>
  <h3 class="text-sm font-bold mb-2" style="color: var(--color-text-strong);">Ask AI</h3>
  <p class="text-sm mb-4" style="color: var(--color-text);">Ask anything about PilserLab or try one of the examples below.</p>

  <div id="example-chips" class="flex flex-wrap gap-2 mb-6">
    {examples.map((ex) => (
      <button
        class="example-chip px-1.5 py-0.5 text-[10px] leading-none rounded-sm cursor-pointer transition"
        style="background: var(--color-bg-weak); color: var(--color-text-weak);"
        data-query={ex.query}
      >{ex.query}</button>
    ))}
  </div>

  <div id="chat-messages" class="chat-scroll">
    <div id="fallback-hint" class="flex flex-col items-center justify-center py-12 gap-3">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-weak)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <p class="text-center leading-relaxed" style="color: var(--color-text-weak); font-size: 0.8125rem;">{hero.fallback}</p>
    </div>
  </div>

  <div id="typing-indicator" class="hidden" style="padding: 12px 16px 12px 52px; margin-bottom: 10px; position: relative;">
    <div class="msg-avatar" style="position: absolute; left: 16px; top: 12px; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-weak)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.5 5h5l-4 3 1.5 5-4-3-4 3 1.5-5-4-3h5z"/></svg>
    </div>
    <div class="typing-dots">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>

  <!-- Auth Section: shown when not registered -->
  <div id="auth-section">
    <div id="auth-form" class="flex flex-col gap-3 mt-6 p-5 rounded-xl" style="border: 1px solid var(--color-border); background: var(--color-bg);">
      <div class="flex items-center gap-3 mb-1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-bg-interactive)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="text-sm font-bold" style="color: var(--color-text-strong);">Welcome! Enter your phone to start</span>
      </div>
      <div class="flex flex-col sm:flex-row gap-2">
        <select id="country-code" class="px-3 py-2.5 text-sm rounded-lg outline-none transition" style="border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono); min-width: 5rem;">
          <option value="256">🇺🇬 +256</option>
          <option value="1">🇺🇸 +1</option>
          <option value="44">🇬🇧 +44</option>
          <option value="254">🇰🇪 +254</option>
          <option value="255">🇹🇿 +255</option>
          <option value="250">🇷🇼 +250</option>
          <option value="257">🇧🇮 +257</option>
          <option value="243">🇨🇩 +243</option>
          <option value="211">🇸🇸 +211</option>
          <option value="256" disabled>──────────</option>
          <option value="91">🇮🇳 +91</option>
          <option value="86">🇨🇳 +86</option>
          <option value="81">🇯🇵 +81</option>
          <option value="233">🇬🇭 +233</option>
          <option value="234">🇳🇬 +234</option>
          <option value="27">🇿🇦 +27</option>
          <option value="33">🇫🇷 +33</option>
          <option value="49">🇩🇪 +49</option>
          <option value="61">🇦🇺 +61</option>
        </select>
        <input id="phone-input" type="tel" placeholder="Phone number (e.g. 757337153)" class="flex-1 px-4 py-2.5 text-sm rounded-lg outline-none transition" style="border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono);" />
      </div>
      <input id="name-input" type="text" placeholder="Name (optional)" class="w-full px-4 py-2.5 text-sm rounded-lg outline-none transition" style="border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono);" />
      <button id="register-btn" class="w-full px-6 py-2.5 text-sm font-medium rounded-lg cursor-pointer transition" style="background: var(--color-bg-interactive); color: var(--color-text-inverted); border: none;">Get Started →</button>
      <p id="auth-error" class="text-xs hidden" style="color: #ff3b30; text-align: center;"></p>
    </div>
  </div>

  <!-- User Badge: shown when registered -->
  <div id="user-badge" class="hidden flex items-center gap-2 mt-4 px-3 py-1.5 rounded-lg" style="border: 1px solid var(--color-border-weak); background: var(--color-bg-weak);">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-weak)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span id="badge-display" class="text-xs flex-1" style="color: var(--color-text-strong);"></span>
    <button id="logout-btn" class="text-xs px-2 py-0.5 rounded cursor-pointer transition" style="color: var(--color-text-weak); border: 1px solid var(--color-border-weak); background: transparent;">Logout</button>
  </div>

  <form id="chat-form" class="flex flex-col sm:flex-row gap-3 mt-5">
    <textarea
      id="chat-input"
      placeholder="Type your message here..."
      rows="2"
      class="flex-1 px-5 py-3.5 text-sm rounded-xl resize-none outline-none transition leading-relaxed"
      style="min-height: 52px; max-height: 160px; border: 1.5px solid var(--color-border); background: var(--color-bg-weak); color: var(--color-text-strong); font-family: var(--font-mono);"
    ></textarea>
    <button
      type="submit"
      id="send-btn"
      class="px-5 py-3.5 sm:px-6 sm:self-stretch text-sm font-medium rounded-xl cursor-pointer whitespace-nowrap transition flex items-center justify-center gap-2"
    >
      <span class="hidden sm:inline">Send</span>
      <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </form>
</section>

<style>
  .example-chip:hover { background: var(--color-bg-weak-hover) !important; color: var(--color-text) !important; }
  #chat-input:focus { border-color: var(--color-bg-interactive) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-bg-interactive) 30%, transparent) !important; }
  #chat-input::placeholder { color: var(--color-text-weak); opacity: 0.7; }
  :global(#chat-messages > .message-row) { display: flex; flex-direction: column; margin-bottom: 16px; animation: msg-slide-in 0.2s ease-out; }
  @keyframes msg-slide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  :global(#chat-messages > .message-row.user) { align-items: flex-end; }
  :global(#chat-messages > .message-row.assistant) { align-items: flex-start; }
  :global(#chat-messages > .message-row .msg-avatar) { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  :global(#chat-messages > .message-row.user .msg-avatar) { background: var(--color-bg-interactive); border: 1px solid var(--color-border-weak); }
  :global(#chat-messages > .message-row.assistant .msg-avatar) { background: var(--color-bg-weak); border: 1px solid var(--color-border-weak); }
  :global(#chat-messages > .message-row .msg-avatar svg) { width: 12px; height: 12px; }
  :global(#chat-messages > .message-row.user .msg-avatar svg) { stroke: var(--color-text-inverted); }
  :global(#chat-messages > .message-row.assistant .msg-avatar svg) { stroke: var(--color-text-weak); }
  :global(#chat-messages > .message-row .msg-content) { padding: 12px 16px; font-size: 0.875rem; line-height: 1.75; word-wrap: break-word; border-radius: 10px; width: 100%; box-sizing: border-box; }
  :global(#chat-messages > .message-row.user .msg-content) { border: 1px solid var(--color-border-weak); color: var(--color-text-inverted); font-weight: 450; background: var(--color-bg-interactive); border-bottom-right-radius: 4px; max-width: 75%; width: auto; }
  :global(#chat-messages > .message-row.assistant .msg-content) { border: 1px solid var(--color-border-weak); color: var(--color-text); background: var(--color-bg); border-bottom-left-radius: 4px; }
  :global(.chat-markdown) p { margin-bottom: 0.75rem; line-height: 1.75; }
  :global(.chat-markdown) p:last-child { margin-bottom: 0; }
  :global(.chat-markdown) ul, :global(.chat-markdown) ol { margin: 0.5rem 0; padding-left: 1.5rem; line-height: 1.75; }
  :global(.chat-markdown) li { margin-bottom: 0.25rem; }
  :global(.chat-markdown) strong { color: var(--color-text-strong); font-weight: 600; }
  :global(.chat-markdown) em, :global(.chat-markdown) i { font-style: italic; color: var(--color-text); }
  :global(.chat-markdown) u, :global(.chat-markdown) ins { text-decoration: underline; text-underline-offset: 2px; }
  :global(.chat-markdown) del, :global(.chat-markdown) s, :global(.chat-markdown) strike { text-decoration: line-through; color: var(--color-text-weak); }
  :global(.chat-markdown) mark { background: color-mix(in srgb, var(--color-bg-interactive) 25%, transparent); color: var(--color-text-strong); padding: 0 4px; border-radius: 3px; }
  :global(.chat-markdown) q { font-style: italic; }
  :global(.chat-markdown) q::before { content: '\201C'; }
  :global(.chat-markdown) q::after { content: '\201D'; }
  :global(.chat-markdown) kbd { font-family: var(--font-mono); font-size: 0.75rem; padding: 1px 5px; border-radius: 4px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); color: var(--color-text-strong); box-shadow: 0 1px 0 var(--color-border-weak); }
  :global(.chat-markdown) small { font-size: 0.75rem; color: var(--color-text-weak); }
  :global(.chat-markdown) sup { font-size: 0.6875rem; vertical-align: super; }
  :global(.chat-markdown) sub { font-size: 0.6875rem; vertical-align: sub; }
  :global(.chat-markdown) a { color: var(--color-bg-interactive); text-decoration: underline; text-underline-offset: 2px; }
  :global(.chat-markdown) a:hover { opacity: 0.8; }
  :global(.chat-markdown) abbr { text-decoration: underline dotted; text-underline-offset: 2px; cursor: help; }
  :global(.chat-markdown) dl { margin: 0.5rem 0; line-height: 1.75; }
  :global(.chat-markdown) dt { font-weight: 600; color: var(--color-text-strong); }
  :global(.chat-markdown) dd { margin-left: 1.5rem; color: var(--color-text); }
  :global(.chat-markdown) h1, :global(.chat-markdown) h2, :global(.chat-markdown) h3 { color: var(--color-text-strong); font-weight: 600; margin: 1rem 0 0.5rem; }
  :global(.chat-markdown) h1 { font-size: 1.125rem; }
  :global(.chat-markdown) h2 { font-size: 1rem; }
  :global(.chat-markdown) h3 { font-size: 0.9375rem; }
  :global(.chat-markdown) pre { margin: 0.75rem 0; border-radius: 6px; overflow-x: auto; }
  :global(.chat-markdown) pre code { font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.6; }
  :global(.chat-markdown) :not(pre) > code { background: var(--color-bg-weak); padding: 2px 6px; border-radius: 4px; font-size: 0.8125rem; color: var(--color-text-strong); }
  :global(.chat-markdown) blockquote { border-left: 3px solid var(--color-border-weak); padding-left: 1rem; margin: 0.75rem 0; color: var(--color-text-weak); }
  :global(.chat-markdown .table-outer-wrap) { position: relative; margin: 0.75rem 0; }
  :global(.chat-markdown .table-wrap) { overflow-x: auto; }
  :global(.chat-markdown .table-wrap table) { border-collapse: collapse; width: 100%; min-width: 480px; margin: 0; }
  :global(.chat-markdown th), :global(.chat-markdown td) { border: 1.5px solid var(--color-border); padding: 8px 12px; text-align: left; font-size: 0.8125rem; line-height: 1.5; }
  :global(.chat-markdown th) { color: var(--color-text-strong); font-weight: 700; background: var(--color-bg-interactive-weak); white-space: nowrap; }
  :global(.chat-markdown tr:nth-child(even) td) { background: var(--color-bg); }
  :global(.chat-markdown .table-outer-wrap .scroll-fade) {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 48px;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(.chat-markdown .table-outer-wrap .scroll-arrow) {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
    font-size: 0.75rem;
    color: var(--color-text-weak);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
    line-height: 1;
  }
  :global(.chat-markdown .table-outer-wrap.overflow:not(.scrolled-end):not(.scrolling) .scroll-fade),
  :global(.chat-markdown .table-outer-wrap.overflow:not(.scrolled-end):not(.scrolling) .scroll-arrow) {
    opacity: 1;
  }
  :global(.chat-markdown) hr { border: none; border-top: 1px solid var(--color-border-weak); margin: 1rem 0; }
  /* Thinking block — compact, collapsed when done */
  :global(.thinking-block) { margin-bottom: 4px; }
  :global(.thinking-block details) { margin: 0; }
  :global(.thinking-block summary) { font-size: 0.6875rem; color: var(--color-text-weak); cursor: pointer; user-select: none; display: inline-flex; align-items: center; gap: 4px; padding: 1px 0; }
  :global(.thinking-block summary)::before { content: none; }
  :global(.thinking-block summary .think-icon) { width: 0.75rem; height: 0.75rem; flex-shrink: 0; color: var(--color-bg-interactive); display: inline-block; }
  :global(.thinking-block pre) { font-size: 0.6875rem; color: var(--color-text-weak); background: var(--color-bg-weak); padding: 6px 10px; border-radius: 4px; margin: 4px 0 0; white-space: pre-wrap; word-break: break-word; max-height: 120px; overflow-y: auto; }
  /* Tool call pill — compact inline badge */
  :global(.tool-call-pill) { display: inline-flex; flex-direction: column; margin-bottom: 4px; margin-left: 38px; cursor: pointer; }
  :global(.tool-call-pill .tc-pill-inner) { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 10px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); font-size: 0.6875rem; line-height: 1.4; }
  :global(.tool-call-pill .tc-icon) { width: 0.6875rem; height: 0.6875rem; flex-shrink: 0; color: var(--color-text-weak); display: inline-block; }
  :global(.tool-call-pill .tc-pill-name) { font-family: var(--font-mono); color: var(--color-text-strong); }
  :global(.tool-call-pill .tc-pill-status) { font-size: 0.625rem; }
  :global(.tool-call-pill .tc-pill-status.running) { color: var(--color-status-running); }
  :global(.tool-call-pill .tc-pill-status.done) { color: var(--color-status-success); }
  :global(.tool-call-pill .tc-pill-status.error) { color: var(--color-status-error); }
  :global(.tool-call-pill .tc-pill-detail) { margin-top: 3px; padding: 4px 8px; font-size: 0.6875rem; background: var(--color-bg); border-radius: 4px; border: 1px solid var(--color-border-weak); }
  :global(.tool-call-pill .tc-pill-detail pre) { font-size: 0.6875rem; font-family: var(--font-mono); line-height: 1.5; margin: 0; white-space: pre-wrap; word-break: break-word; }
  :global(.tool-call-pill .tc-pill-detail details) { margin-top: 2px; }
  :global(.tool-call-pill .tc-pill-detail summary) { font-size: 0.6875rem; color: var(--color-text-weak); cursor: pointer; }
  #typing-indicator.active { display: block; }
  .typing-dots { display: flex; align-items: center; gap: 5px; padding: 2px 0; }
  .typing-dots .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-text-weak); animation: typing-bounce 1.4s infinite ease-in-out both; }
  .typing-dots .dot:nth-child(1) { animation-delay: -0.32s; }
  .typing-dots .dot:nth-child(2) { animation-delay: -0.16s; }
  .typing-dots .dot:nth-child(3) { animation-delay: 0s; }
  @keyframes typing-bounce { 0%, 80%, 100% { transform: translateY(0) scale(0.6); } 40% { transform: translateY(-4px) scale(1); } }
  /* Send button */
  #send-btn { background: var(--color-bg-interactive); color: var(--color-text-inverted); border: none; }
  #send-btn:hover { background: var(--color-bg-interactive-weak) !important; color: var(--color-text-strong) !important; }
  @media (prefers-color-scheme: dark) {
    #send-btn { background: var(--color-bg-interactive-weak); color: var(--color-text-strong); }
    #send-btn:hover { background: var(--color-bg-interactive) !important; color: var(--color-text-inverted) !important; }
  }
  /* Auth form styles */
  #country-code:focus, #phone-input:focus, #name-input:focus { border-color: var(--color-bg-interactive) !important; box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-bg-interactive) 25%, transparent) !important; }
  #country-code::placeholder, #phone-input::placeholder, #name-input::placeholder { color: var(--color-text-weak); opacity: 0.7; }
  #register-btn:hover { opacity: 0.85 !important; }
  #logout-btn:hover { background: var(--color-bg-weak-hover) !important; color: var(--color-text) !important; }
  /* Inline media */
  :global(.chat-markdown img) { max-width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--color-border-weak); cursor: pointer; display: block; margin: 0.75rem 0; transition: opacity 0.2s; }
  :global(.chat-markdown img:hover) { opacity: 0.85; }
  :global(.chat-markdown video) { max-width: 100%; border-radius: 8px; border: 1px solid var(--color-border-weak); margin: 0.75rem 0; display: block; }
  :global(.chat-markdown .file-embed) { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--color-border-weak); background: var(--color-bg-weak); font-size: 0.8125rem; text-decoration: none; margin: 0.375rem 0; color: var(--color-text-strong); transition: background 0.2s; }
  :global(.chat-markdown .file-embed:hover) { background: var(--color-bg-weak-hover); }
  :global(.chat-markdown .file-embed .file-icon) { font-size: 1rem; flex-shrink: 0; }
  :global(.chat-markdown iframe.pdf-embed) { width: 100%; height: 500px; border: 1px solid var(--color-border-weak); border-radius: 8px; margin: 0.75rem 0; }
  /* Lightbox */
  #lightbox { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.25s; cursor: zoom-out; }
  #lightbox.active { opacity: 1; pointer-events: auto; }
  #lightbox img { max-width: 90vw; max-height: 90vh; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,0.5); }
  #lightbox .lb-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.15); color: #fff; border: none; font-size: 1.25rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
  #lightbox .lb-close:hover { background: rgba(255,255,255,0.3); }
  #chat { flex: 1; display: flex; flex-direction: column; min-height: 90dvh; }
  .chat-scroll { flex: 1; overflow-y: auto; scroll-behavior: smooth; min-height: 100px; }
  #chat-form { flex-shrink: 0; }
  @media (max-width: 639px) {
    .chat-scroll { min-height: 80px; }
  }
</style>

<script>
  import { marked } from 'marked';
  import hljs from 'highlight.js';

  var THINK_ICON = '<svg class="think-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.5 5h5l-4 3 1.5 5-4-3-4 3 1.5-5-4-3h5z"/></svg>';
  var TOOL_ICON = '<svg class="tc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>';

  var form = document.getElementById('chat-form');
  var input = document.getElementById('chat-input');
  var messages = document.getElementById('chat-messages');
  var hint = document.getElementById('fallback-hint');
  var typingEl = document.getElementById('typing-indicator');
  var authSection = document.getElementById('auth-section');
  var userBadge = document.getElementById('user-badge');
  var badgeDisplay = document.getElementById('badge-display');
  var registerBtn = document.getElementById('register-btn');
  var phoneInput = document.getElementById('phone-input');
  var nameInput = document.getElementById('name-input');
  var countryCode = document.getElementById('country-code');
  var authError = document.getElementById('auth-error');
  var logoutBtn = document.getElementById('logout-btn');

  var ws = null;
  var connected = false;

  // Streaming state
  var streamingEl = null;
  var streamingContent = '';
  var streamingThinking = '';
  var pendingToolCalls = [];

  // Auth state
  var phone = localStorage.getItem('zerowrapper_phone') || '';
  var displayName = localStorage.getItem('zerowrapper_name') || '';
  var sessionId = localStorage.getItem('zerowrapper_session') || '';

  function initAuth() {
    if (phone) {
      showAuthenticated();
    } else {
      showAuthForm();
    }
  }

  function showAuthForm() {
    if (authSection) authSection.classList.remove('hidden');
    if (userBadge) userBadge.classList.add('hidden');
    // Chat form is always visible, just disable WS sending
  }

  function scrollToAuth() {
    if (authSection) {
      authSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      phoneInput.focus();
      authSection.style.transition = 'box-shadow 0.3s';
      authSection.style.boxShadow = '0 0 0 3px var(--color-bg-interactive)';
      setTimeout(function() { authSection.style.boxShadow = 'none'; }, 2000);
    }
  }

  function showAuthenticated() {
    if (authSection) authSection.classList.add('hidden');
    if (userBadge) userBadge.classList.remove('hidden');
    if (badgeDisplay) {
      var name = displayName || phone;
      badgeDisplay.textContent = phone + (name && name !== phone ? ' (' + name + ')' : '');
    }
    if (!connected) connect();
  }

  function normalizePhone(code, num) {
    num = num.replace(/^0+/, '');
    code = code.replace(/^\+/, '');
    return code + num;
  }

  registerBtn.addEventListener('click', function() {
    var code = countryCode.value;
    var raw = phoneInput.value.trim();
    var name = nameInput.value.trim();
    if (!raw) { authError.textContent = 'Please enter your phone number.'; authError.classList.remove('hidden'); return; }
    authError.classList.add('hidden');
    var normalizedPhone = normalizePhone(code, raw);

    // Try login first
    fetch('/api/login?phone=' + encodeURIComponent(normalizedPhone))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.exists) {
          // User exists — login
          phone = data.phone;
          displayName = data.name || phone;
          localStorage.setItem('zerowrapper_phone', phone);
          localStorage.setItem('zerowrapper_name', displayName);
          showAuthenticated();
        } else {
          // Register
          return fetch('/api/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: normalizedPhone, name: name || undefined })
          }).then(function(r) { return r.json(); })
          .then(function(data2) {
            if (data2.ok) {
              phone = data2.phone;
              displayName = data2.name || phone;
              localStorage.setItem('zerowrapper_phone', phone);
              localStorage.setItem('zerowrapper_name', displayName);
              showAuthenticated();
            } else {
              authError.textContent = data2.error || 'Registration failed.';
              authError.classList.remove('hidden');
            }
          });
        }
      })
      .catch(function() {
        authError.textContent = 'Network error. Please try again.';
        authError.classList.remove('hidden');
      });
  });

  // Allow Enter to submit auth form
  phoneInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') registerBtn.click(); });
  nameInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') registerBtn.click(); });

  logoutBtn.addEventListener('click', function() {
    localStorage.removeItem('zerowrapper_phone');
    localStorage.removeItem('zerowrapper_name');
    localStorage.removeItem('zerowrapper_session');
    phone = '';
    displayName = '';
    sessionId = '';
    if (ws) { ws.close(); ws = null; }
    connected = false;
    messages.innerHTML = '';
    if (hint) hint.style.display = 'block';
    showAuthForm();
  });

  document.querySelectorAll('.example-chip').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (!phone) { scrollToAuth(); return; }
      input.value = btn.getAttribute('data-query') || '';
      autoGrow();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    });
  });

  function connect() {
    var protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    ws = new WebSocket(protocol + '//' + location.host + '/ws');
    ws.onopen = function() {
      connected = true;
      if (hint) hint.style.display = 'none';
      fetchHistory();
    };
    ws.onmessage = function(e) {
      try {
        var data = JSON.parse(e.data);
        switch (data.type) {
          case 'session_created':
            if (data.session_id && data.session_id !== sessionId) {
              sessionId = data.session_id;
              localStorage.setItem('zerowrapper_session', sessionId);
            }
            break;
          case 'thinking': handleThinking(data.content); break;
          case 'chunk': handleChunk(data.content); break;
          case 'chunk_reset': handleChunkReset(); break;
          case 'tool_call': handleToolCall(data.tool_call_id, data.name, data.args); break;
          case 'tool_result': handleToolResult(data.tool_call_id, data.name, data.output); break;
          case 'done': handleDone(data.content); break;
          case 'error': addMessage('error', data.message || data.error || 'Unknown error'); break;
        }
      } catch(e2) { addMessage('assistant', e.data); }
    };
    ws.onclose = function() { connected = false; streamingReset(); if (hint) hint.style.display = 'block'; };
    ws.onerror = function() { connected = false; streamingReset(); if (hint) hint.style.display = 'block'; };
  }

  function fetchHistory() {
    if (!phone) return;
    var url = '/api/history?user_id=' + encodeURIComponent(phone);
    console.log('fetchHistory: requesting', url);
    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        console.log('fetchHistory: got', data.messages ? data.messages.length : 0, 'messages', data);
        // Capture session_id from history response (server knows the correct format)
        if (data.session_id && !sessionId) {
          sessionId = data.session_id;
          localStorage.setItem('zerowrapper_session', sessionId);
        }
        if (!data.messages || data.messages.length === 0) return;
        data.messages.forEach(function(msg) {
          if (msg.role === 'user' || msg.role === 'assistant') {
            var row = document.createElement('div');
            row.className = 'message-row ' + msg.role;
            var avatar = document.createElement('div');
            avatar.className = 'msg-avatar';
            avatar.innerHTML = msg.role === 'user' ? USER_AVATAR : BOT_AVATAR;
            row.appendChild(avatar);
            var content = document.createElement('div');
            content.className = 'msg-content' + (msg.role === 'assistant' ? ' chat-markdown' : '');
            if (msg.role === 'assistant') {
              renderMarkdown(content, marked.parse(msg.content || ''));
            } else {
              content.textContent = msg.content || '';
            }
            row.appendChild(content);
            messages.appendChild(row);
          }
        });
        messages.scrollTop = messages.scrollHeight;
        setTimeout(function() { messages.scrollTop = messages.scrollHeight; }, 50);
      })
      .catch(function() {});
  }

  function highlight(el) {
    el.querySelectorAll('pre code').forEach(function(block) {
      hljs.highlightElement(block);
    });
  }

  function wrapTables(el) {
    el.querySelectorAll('table').forEach(function(t) {
      if (t.parentElement && t.parentElement.classList.contains('table-wrap')) return;
      var outer = document.createElement('div');
      outer.className = 'table-outer-wrap';
      var wrapper = document.createElement('div');
      wrapper.className = 'table-wrap';
      t.parentNode.insertBefore(outer, t);
      outer.appendChild(wrapper);
      wrapper.appendChild(t);
      var fade = document.createElement('div');
      fade.className = 'scroll-fade';
      outer.appendChild(fade);
      var arrow = document.createElement('div');
      arrow.className = 'scroll-arrow';
      arrow.textContent = '\u2192';
      outer.appendChild(arrow);
      var scrollTimer;
      updateOverflow();
      wrapper.addEventListener('scroll', function() {
        outer.classList.add('scrolling');
        clearTimeout(scrollTimer);
        checkScrollEnd();
      });
      var ro = new ResizeObserver(updateOverflow);
      ro.observe(wrapper);
      function checkScrollEnd() {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function() {
          outer.classList.remove('scrolling');
          updateOverflow();
        }, 350);
      }
      function updateOverflow() {
        if (wrapper.scrollWidth > wrapper.clientWidth) {
          outer.classList.add('overflow');
          var atEnd = wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 1;
          outer.classList.toggle('scrolled-end', atEnd);
        } else {
          outer.classList.remove('overflow', 'scrolled-end', 'scrolling');
        }
      }
    });
  }

  function renderMarkdown(el, html) {
    el.innerHTML = html;
    wrapTables(el);
    highlight(el);
  }

  // --- Streaming handlers ---

  function ensureStreamingEl() {
    if (!streamingEl) {
      var row = document.createElement('div');
      row.className = 'message-row assistant';
      var avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.innerHTML = BOT_AVATAR;
      row.appendChild(avatar);
      streamingEl = document.createElement('div');
      streamingEl.className = 'msg-content chat-markdown';
      row.appendChild(streamingEl);
      messages.appendChild(row);
    }
    return streamingEl;
  }

  function renderStreaming() {
    var el = ensureStreamingEl();
    var html = '';
    if (streamingThinking) {
      html += '<div class="thinking-block"><details open><summary>' + THINK_ICON + ' Thinking</summary><pre>' + escapeHtml(streamingThinking) + '</pre></details></div>';
    }
    if (streamingContent) {
      html += marked.parse(streamingContent);
    }
    renderMarkdown(el, html);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function handleThinking(content) {
    hideTyping();
    streamingThinking += content;
    renderStreaming();
  }

  function handleChunk(content) {
    hideTyping();
    streamingContent += content;
    renderStreaming();
  }

  function handleChunkReset() {
  }

  function handleToolCall(id, name, args) {
    hideTyping();
    if (streamingContent || streamingThinking) {
      finalizeStreaming();
    }

    var pill = document.createElement('div');
    pill.className = 'tool-call-pill';
    pill.dataset.id = id || '';
    var argsStr = args ? JSON.stringify(args, null, 2) : null;
    pill.innerHTML = '<div class="tc-pill-inner">' +
      TOOL_ICON +
      '<span class="tc-pill-name">' + escapeHtml(name) + '</span>' +
      '<span class="tc-pill-status running">\u25CC</span>' +
    '</div>' +
    (argsStr ? '<div class="tc-pill-detail hidden"><pre>' + escapeHtml(argsStr) + '</pre></div>' : '');
    pill.addEventListener('click', function() {
      var detail = pill.querySelector('.tc-pill-detail');
      if (detail) detail.classList.toggle('hidden');
    });
    messages.appendChild(pill);
    pill.scrollIntoView({ behavior: 'smooth', block: 'end' });
    pendingToolCalls.push({ id: id || '', el: pill, name: name });
  }

  function handleToolResult(id, name, output) {
    var idx = -1;
    for (var i = 0; i < pendingToolCalls.length; i++) {
      if (pendingToolCalls[i].id === id || pendingToolCalls[i].name === name) {
        idx = i; break;
      }
    }
    if (idx === -1) return;
    var item = pendingToolCalls[idx];
    pendingToolCalls.splice(idx, 1);

    var status = item.el.querySelector('.tc-pill-status');
    if (status) {
      status.className = 'tc-pill-status done';
      status.innerHTML = '\u2713';
    }

    // Render web_files_render results inline
    if (name === 'web_files_render' && output) {
      try {
        var parsed = JSON.parse(output);
        if (parsed.files && parsed.files.length > 0) {
          renderFiles(parsed.files);
          output = 'Rendered ' + parsed.files.length + ' file(s)'; // short status in pill
        }
      } catch(e) {}
    }

    if (output) {
      var detail = item.el.querySelector('.tc-pill-detail');
      var existed = !!detail;
      if (!detail) {
        detail = document.createElement('div');
        detail.className = 'tc-pill-detail hidden';
        item.el.appendChild(detail);
      }
      if (output.length <= 80) {
        detail.textContent = output;
      } else {
        detail.innerHTML = '<details><summary>' + output.slice(0, 80) + '...</summary><pre>' + escapeHtml(output) + '</pre></details>';
      }
      if (!existed) {
        item.el.addEventListener('click', function() {
          detail.classList.toggle('hidden');
        });
      }
    }
    item.el.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function finalizeStreaming() {
    if (!streamingEl) return;
    var html = '';
    if (streamingThinking) {
      html += '<div class="thinking-block"><details><summary>' + THINK_ICON + ' Thinking</summary><pre>' + escapeHtml(streamingThinking) + '</pre></details></div>';
    }
    var content = streamingContent.trim();
    if (content) {
      streamingEl.className = 'msg-content chat-markdown';
      html += marked.parse(content);
      renderMarkdown(streamingEl, html);
    } else {
      streamingEl.className = 'msg-content';
      streamingEl.textContent = streamingThinking || '(generating response...)';
    }
    streamingEl = null;
    streamingContent = '';
    streamingThinking = '';
  }

  function streamingReset() {
    if (streamingEl) {
      var parent = streamingEl.parentElement;
      if (parent) parent.remove();
      streamingEl = null;
    }
    streamingContent = '';
    streamingThinking = '';
    pendingToolCalls = [];
  }

  function renderFiles(files) {
    files.forEach(function(file) {
      if (!file.url || !file.cached) return;
      var row = document.createElement('div');
      row.className = 'message-row assistant';
      var avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.innerHTML = BOT_AVATAR;
      row.appendChild(avatar);
      var content = document.createElement('div');
      content.className = 'msg-content chat-markdown';

      var mime = file.mime_type || '';
      var name = file.original_path.split('/').pop() || 'file';
      if (mime.startsWith('image/')) {
        var img = document.createElement('img');
        img.src = file.url;
        img.alt = name;
        img.loading = 'lazy';
        content.appendChild(img);
      } else if (mime.startsWith('video/')) {
        var video = document.createElement('video');
        video.src = file.url;
        video.controls = true;
        video.preload = 'metadata';
        content.appendChild(video);
      } else if (mime === 'application/pdf') {
        var iframe = document.createElement('iframe');
        iframe.src = file.url;
        iframe.className = 'pdf-embed';
        iframe.title = name;
        content.appendChild(iframe);
      } else {
        var a = document.createElement('a');
        a.href = file.url;
        a.className = 'file-embed';
        a.target = '_blank';
        a.innerHTML = '<span class="file-icon">&#128206;</span> ' + escapeHtml(name) + ' <span style="color:var(--color-text-weak);font-size:0.75rem;">(' + formatSize(file.file_size) + ')</span>';
        content.appendChild(a);
      }

      row.appendChild(content);
      messages.appendChild(row);
      row.scrollIntoView({ behavior: 'smooth', block: 'end' });
    });
  }

  function showTyping() { if (typingEl) typingEl.classList.add('active'); }
  function hideTyping() { if (typingEl) typingEl.classList.remove('active'); }

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function formatSize(bytes) {
    if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + ' MB';
    if (bytes >= 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return bytes + ' B';
  }

  // --- Lightbox ---
  var lightbox = null;
  function openLightbox(src) {
    if (!lightbox) {
      lightbox = document.createElement('div');
      lightbox.id = 'lightbox';
      lightbox.innerHTML = '<button class="lb-close">&times;</button>';
      document.body.appendChild(lightbox);
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox || e.target.classList.contains('lb-close')) closeLightbox();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });
    }
    var img = lightbox.querySelector('img');
    if (!img) {
      img = document.createElement('img');
      lightbox.appendChild(img);
    }
    img.src = src;
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  var USER_AVATAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
  var BOT_AVATAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';

  function addMessage(role, text) {
    if (streamingEl) finalizeStreaming();

    var row = document.createElement('div');
    row.className = 'message-row ' + role;
    if (role === 'error') {
      var content = document.createElement('div');
      content.className = 'msg-content';
      content.textContent = text;
      row.appendChild(content);
    } else if (role === 'user') {
      var avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.innerHTML = USER_AVATAR;
      row.appendChild(avatar);
      var content = document.createElement('div');
      content.className = 'msg-content';
      content.textContent = text;
      row.appendChild(content);
    } else {
      var avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.innerHTML = BOT_AVATAR;
      row.appendChild(avatar);
      var content = document.createElement('div');
      content.className = 'msg-content chat-markdown';
      renderMarkdown(content, marked.parse(text || ''));
      row.appendChild(content);
    }
    messages.appendChild(row);
    if (hint && hint.style.display !== 'none') hint.style.display = 'none';
    row.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }

  function handleDone(content) {
    hideTyping();
    if (content) {
      streamingContent = content;
    }
    finalizeStreaming();
  }

  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 300) + 'px';
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!phone) { scrollToAuth(); return; }
    if (streamingEl) finalizeStreaming();
    var text = input.value.trim();
    if (!text) return;
    if (!connected) { addMessage('error', 'Not connected to backend.'); return; }
    addMessage('user', text);
    ws.send(JSON.stringify({ session_id: sessionId || '', user_id: phone, content: text }));
    showTyping();
    input.value = '';
    input.style.height = 'auto';
  });

  input.addEventListener('input', autoGrow);

  // Delegated click: images open lightbox
  messages.addEventListener('click', function(e) {
    var target = e.target;
    if (target.tagName === 'IMG' && target.closest('.chat-markdown')) {
      openLightbox(target.src);
    }
  });

  initAuth();
</script>
