---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ChatApp from '../components/ChatApp.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import landing from '../data/landing.json' assert { type: 'json' };
import settings from '../data/sitesettings.json' assert { type: 'json' };
---

<BaseLayout>
  <div
    class="flex flex-col min-h-screen"
    style="font-family: var(--font-sans); color: var(--color-text); background: var(--color-bg);"
  >
    <div
      id="page-root"
      class="w-full mx-auto flex flex-col min-h-screen"
      style="max-width: 67.5rem; border: 1px solid var(--color-border-weak); border-top: none;"
    >
      <Header />
      <main class="flex-1 flex flex-col">
        <ChatApp />
        <Hero />
        <FAQ />
      </main>
      <Footer />
    </div>
  </div>

  <script type="application/json" id="landing-data" set:html={JSON.stringify(landing)}></script>
  <script type="application/json" id="settings-data" set:html={JSON.stringify(settings)}></script>
</BaseLayout>
