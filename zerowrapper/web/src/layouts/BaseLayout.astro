---
import '../styles/global.css';
import settings from '../data/sitesettings.json' assert { type: 'json' };
const { site } = settings;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    <script is:inline>
      (function(){
        var saved = localStorage.getItem('theme');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else {
          document.documentElement.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
          mq.addEventListener('change', function(e) {
            if (!localStorage.getItem('theme')) {
              document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
          });
        }
      })();
    </script>
    <script is:inline>
      (function(){
        var log = function(tag, msg) { try { console.log('[load]', tag, msg) } catch(e) {} };
        var perf = window.performance;

        function dumpResources(label) {
          if (!perf) { log(label, 'no perf API'); return; }
          var all = perf.getEntriesByType('resource');
          var pending = [];
          for (var i = 0; i < all.length; i++) {
            if (!all[i].responseEnd || all[i].responseEnd <= 0) {
              pending.push(all[i].name);
            }
          }
          log(label, 'readyState=' + document.readyState + ' total=' + all.length + ' pending=' + pending.length);
          if (pending.length > 0) {
            for (var i = 0; i < pending.length; i++) {
              log(label, '  STUCK: ' + pending[i]);
            }
          }
          log(label, 'ALL RESOURCES:');
          for (var i = 0; i < all.length; i++) {
            var e = all[i];
            var dur = (e.responseEnd && e.responseEnd > 0) ? Math.round(e.responseEnd - e.startTime) + 'ms' : 'pending';
            log(label, '  ' + e.name.split('/').pop() + ' -> ' + dur + ' (' + e.initiatorType + ')');
          }
        }

        dumpResources('init');
        setTimeout(function() { dumpResources('5s-timeout'); }, 5000);
        setTimeout(function() { dumpResources('10s-timeout'); }, 10000);
        setTimeout(function() { dumpResources('30s-timeout'); }, 30000);

        window.addEventListener('load', function() {
          log('event', 'window.load FIRED at ' + (perf && perf.now ? Math.round(perf.now()) + 'ms' : '?'));
          dumpResources('on-load');
        });

        window.addEventListener('error', function(e) {
          log('error', 'Uncaught: ' + (e.message || e.error || (e.target && e.target.src) || '?'));
        }, true);
      })();
    </script>
    <style>
      #bg-canvas { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
    </style>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
    <canvas id="bg-canvas"></canvas>
    <script is:inline>
      var canvas = document.getElementById('bg-canvas');
      var ctx = canvas.getContext('2d');
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function resize() {
        var dpr = window.devicePixelRatio || 1;
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function draw(time) {
        if (!prefersReduced) requestAnimationFrame(draw);
        var w = window.innerWidth, h = window.innerHeight;
        ctx.clearRect(0, 0, w, h);

        var topSpacing = 12, bottomSpacing = 48;
        var topSize = 1.5, bottomSize = 4;
        var topAlpha = 0.28, bottomAlpha = 0.05;
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        var dotColor = isDark
          ? 'hsl(28, 90%, 50%)'
          : getComputedStyle(document.documentElement).getPropertyValue('--color-bg-strong').trim() || 'hsl(0, 5%, 12%)';

        ctx.fillStyle = dotColor;
        var y = 4;
        while (y < h) {
          var t = Math.min(y / h, 1);
          var spacing = topSpacing + (bottomSpacing - topSpacing) * t;
          var size = topSize + (bottomSize - topSize) * t;
          var alpha = topAlpha + (bottomAlpha - topAlpha) * t;
          var wave = Math.sin(y * 0.018 + time * 0.0004) * 2.5;

          ctx.globalAlpha = alpha;
          for (var x = -spacing; x < w + spacing; x += spacing) {
            ctx.beginPath();
            ctx.arc(x + wave, y, size, 0, Math.PI * 2);
            ctx.fill();
          }
          y += spacing;
        }
        ctx.globalAlpha = 1;
        if (prefersReduced) return;
      }

      resize();
      window.addEventListener('resize', resize);
      var themeObserver = new MutationObserver(function() { resize(); });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      requestAnimationFrame(draw);
    </script>
  </body>
</html>
