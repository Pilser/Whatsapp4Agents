# WAOS Configuration via Environment Variables
# ============================================================================
# This file is an ALTERNATIVE to config.toml. Every option from the TOML
# config is available as WAOS_{SECTION}__{KEY}. Lines starting with # are
# comments.
#
# Load priority:
#   1. ./config.toml  (if it exists, .env is IGNORED)
#   2. ./.env         (fallback)
#   3. $XDG_CONFIG_HOME/waos/config.toml  (last resort)
# ============================================================================

# --- [paths] ---
WAOS_PATHS__DATA_DIR=./srv/waos
WAOS_PATHS__ACCOUNTS_DIR=./srv/waos/accounts
WAOS_PATHS__SESSIONS_DIR=./srv/waos/sessions
WAOS_PATHS__MEDIA_DIR=./srv/waos/media
WAOS_PATHS__FRONTEND_DIR=./srv/waos/web
WAOS_PATHS__MAIN_DB=./srv/waos/waos.db
WAOS_PATHS__DASHBOARD=./srv/waos/dashboard.json
WAOS_PATHS__DASHBOARD_DELTA=./srv/waos/dashboard.delta

# --- [server] ---
WAOS_SERVER__ENABLED=false
WAOS_SERVER__PORT=8080
WAOS_SERVER__BIND=127.0.0.1
WAOS_SERVER__NO_FRONTEND=false
WAOS_SERVER__JWT_SECRET=changeme-generate-a-real-secret-with-openssl-rand-base64-32

# --- [agent] ---
WAOS_AGENT__WEBHOOK_TOKEN=your-webhook-secret
# Provider: openai | openrouter | custom:http://host:port
WAOS_AGENT__EMBEDDING_PROVIDER=custom:http://localhost:8699
# Model name (e.g. "nomic-embed-text" for Ollama, "text-embedding-3-small" for OpenAI)
WAOS_AGENT__EMBEDDING_MODEL=all-MiniLM-L6-v2
# Output dimensions: 768 for nomic-embed-text, 1536 for openai, 384 for BGE
WAOS_AGENT__EMBEDDING_DIMENSIONS=384
WAOS_AGENT__EMBEDDING_API_KEY=sk-your-api-key

# Accounts are managed via the REST API / main DB, NOT from config.
# The `[[accounts]]` section in config.toml only bootstraps the first run.
# After that, use the web UI or curl to manage accounts:
#   curl -X POST http://localhost:8080/api/accounts \
#     -H "Content-Type: application/json" \
#     -d '{"alias":"my_bot","phone":"+1234567890"}'
