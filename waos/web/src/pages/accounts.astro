---
import Base from '../layouts/Base.astro';
import Modal from '../components/Modal.astro';
---

<Base title="Accounts">
  <div class="flex items-center justify-between mb-6 sm:mb-8">
    <h1 class="text-xl sm:text-2xl font-bold">Accounts</h1>
    <button id="refresh-btn" class="text-xs px-3 py-1.5 rounded-lg border border-waos-border text-waos-dim hover:text-waos-text transition">Refresh</button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2">
      <div id="account-list" class="space-y-3">
        <p class="text-waos-dim italic text-sm">Loading accounts...</p>
      </div>
    </div>

    <div class="space-y-4">
      <div class="bg-waos-surface border border-waos-border rounded-xl p-5">
        <h2 class="text-sm font-semibold mb-4">Add Account</h2>
        <form id="create-form" class="space-y-3">
          <div>
            <label for="alias" class="block text-xs text-waos-dim mb-1">Alias</label>
            <input type="text" id="alias" name="alias" placeholder="my_bot" required
              class="w-full bg-waos-bg border border-waos-border rounded-lg px-3 py-2 text-sm text-waos-text placeholder-waos-dim focus:outline-none focus:border-waos-accent transition">
          </div>
          <button type="submit" class="w-full text-sm font-medium px-4 py-2 rounded-lg bg-waos-accent text-white hover:brightness-110 transition">Create</button>
        </form>
        <p id="create-result" class="text-xs mt-2 hidden"></p>
      </div>
    </div>
  </div>

  <div id="manage-overlay" class="fixed inset-0 z-[60] hidden bg-black/60 backdrop-blur-sm" onclick="if(event.target===this)closeManage()">
    <div class="absolute right-0 top-0 bottom-0 w-full max-w-lg bg-waos-surface border-l border-waos-border overflow-y-auto">
      <div class="px-5 py-4 border-b border-waos-border flex items-center justify-between sticky top-0 bg-waos-surface z-10">
        <h2 class="text-base font-semibold" id="manage-title">Account</h2>
        <button onclick="closeManage()" class="text-waos-dim hover:text-waos-text transition text-2xl leading-none">&times;</button>
      </div>
      <div class="p-5 space-y-5">
        <div class="flex items-center gap-3 flex-wrap">
          <span class="font-semibold" id="manage-alias">—</span>
          <span id="manage-status-badge"></span>
        </div>
        <div class="text-sm space-y-1">
          <div><span class="text-waos-dim">Phone:</span> <span id="manage-phone">—</span></div>
          <div><span class="text-waos-dim">Status:</span> <span id="manage-status-text">—</span></div>
          <div id="manage-error" class="text-waos-danger hidden"></div>
        </div>
        <div class="flex flex-col gap-3">
          <button id="regenerate-qr-btn" class="w-full text-sm font-medium px-4 py-2.5 rounded-lg border border-waos-warn text-waos-warn hover:bg-waos-warn/10 transition">Regenerate QR Code</button>
          <button id="delete-account-btn" class="w-full text-sm font-medium px-4 py-2.5 rounded-lg border border-waos-danger text-waos-danger hover:bg-waos-danger/10 transition">Delete Account</button>
        </div>
        <div class="pt-3 border-t border-waos-border">
          <div class="pt-3 border-t border-waos-border mb-2">
            <h3 class="text-xs font-semibold text-waos-dim uppercase tracking-wider mb-3">Bridge</h3>
            <label class="flex items-center justify-between py-2 cursor-pointer group">
              <div>
                <p class="text-sm text-waos-text group-hover:text-waos-accent transition">Direct Messages</p>
                <p class="text-xs text-waos-dim mt-0.5" id="manage-bridge-dm-label">Forward DMs to agents</p>
              </div>
              <button class="bridge-toggle relative w-11 h-6 rounded-full shrink-0 focus:outline-none" data-key="dm">
                <span class="absolute inset-0 rounded-full transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform shadow-sm"></span>
              </button>
            </label>
            <label class="flex items-center justify-between py-2 cursor-pointer group">
              <div>
                <p class="text-sm text-waos-text group-hover:text-waos-accent transition">Group Messages</p>
                <p class="text-xs text-waos-dim mt-0.5" id="manage-bridge-group-label">Forward group mentions/replies to agents</p>
              </div>
              <button class="bridge-toggle relative w-11 h-6 rounded-full shrink-0 focus:outline-none" data-key="group">
                <span class="absolute inset-0 rounded-full transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform shadow-sm"></span>
              </button>
            </label>
          </div>
          <h3 class="text-xs font-semibold text-waos-dim uppercase tracking-wider mb-3">Agents</h3>
          <div id="manage-agents" class="space-y-2">
            <p class="text-xs text-waos-dim italic">Loading agents...</p>
          </div>
          <p id="manage-agents-result" class="text-xs mt-2 hidden"></p>
        </div>
        <div class="pt-3 border-t border-waos-border">
          <h3 class="text-xs font-semibold text-waos-dim uppercase tracking-wider mb-2">Recent Events</h3>
          <div id="manage-log" class="text-xs font-mono max-h-48 overflow-y-auto space-y-1">
            <p class="text-waos-dim italic">No recent events</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<Modal id="regenerate-modal" title="Regenerate QR Code?" confirmText="Yes, Regenerate" variant="warning">
  <p slot="body" id="regenerate-modal-body">This will log out the current session and clear stored credentials. You will need to scan the new QR code to reconnect. Continue?</p>
</Modal>

<Modal id="delete-modal" title="Delete Account?" confirmText="Yes, Delete" variant="danger">
  <p slot="body">This will permanently remove this account and all its data. This cannot be undone.</p>
</Modal>

<script>
import QRCode from 'qrcode';
var currentAlias = null;

function statusHtml(s) { return WAOS.statusHtml(s); }

function loadAccounts() {
  WAOS.api('/api/accounts').then(function(data) {
    var list = document.getElementById('account-list');
    if (!data.accounts || data.accounts.length === 0) {
      list.innerHTML = '<div class="bg-waos-surface border border-waos-border rounded-xl p-6 text-center"><p class="text-waos-dim text-sm">No accounts yet.</p></div>';
      return;
    }
    list.innerHTML = data.accounts.map(function(a) {
      var li = WAOS.isLoggedIn(a.status);
      var qrInner = li
        ? '<div class="flex flex-col items-center gap-2 text-sm text-emerald-400 justify-center py-3"><svg class="w-8 h-8 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><span>Account already logged in</span></div>'
        : '<div class="text-xs text-waos-dim italic text-center py-3">Waiting for QR code...</div>';
      return '<div class="acct-card bg-waos-surface border border-waos-border rounded-xl p-4" data-alias="' + a.alias + '">' +
        '<div class="flex items-start justify-between gap-3 mb-3">' +
          '<div>' +
            '<div class="flex items-center gap-2 mb-1 flex-wrap">' +
              '<span class="font-semibold text-sm">' + a.alias + '</span>' +
              statusHtml(a.status) +
            '</div>' +
            (a.phone ? '<span class="text-xs text-waos-dim">' + a.phone + '</span>' : '') +
          '</div>' +
          '<button class="manage-btn text-xs px-3 py-1.5 rounded-lg border border-waos-border text-waos-dim hover:text-waos-text shrink-0 transition">Manage &rarr;</button>' +
        '</div>' +
        '<div class="acct-qr-wrap flex flex-col items-center justify-center min-h-[120px] mb-3">' + qrInner + '</div>' +
        '<div class="acct-pair">' +
          '<button class="pair-btn w-full text-sm px-3 py-1.5 rounded-lg border border-waos-info text-waos-info hover:bg-waos-info/10 transition">Pair with Code</button>' +
          '<div class="pair-inline hidden mt-2">' +
            '<div class="pair-confirm-step p-3 bg-waos-bg rounded-lg space-y-3">' +
              '<p class="text-xs text-waos-muted" id="pair-warn-text-' + a.alias + '">This will initiate a pairing request for <strong>' + a.alias + '</strong>. Continue?</p>' +
              '<div class="flex gap-2 justify-end">' +
                '<button class="pair-cancel text-xs px-3 py-1.5 rounded-lg border border-waos-border text-waos-dim hover:text-waos-text transition">Cancel</button>' +
                '<button class="pair-continue text-xs px-3 py-1.5 rounded-lg bg-waos-info text-white hover:brightness-110 transition">Continue</button>' +
              '</div>' +
            '</div>' +
            '<div class="pair-form-step hidden p-3 bg-waos-bg rounded-lg space-y-2">' +
              '<input type="text" class="pair-phone w-full bg-waos-surface border border-waos-border rounded-lg px-3 py-1.5 text-sm placeholder-waos-dim focus:outline-none focus:border-waos-accent" placeholder="5511999999999 (digits only, no +)">' +
              '<button class="pair-submit w-full text-sm px-3 py-1.5 rounded-lg bg-waos-info text-white hover:brightness-110">Send Pair Code</button>' +
              '<p class="pair-result text-xs"></p>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');

    data.accounts.forEach(function(a) {
      if (!WAOS.isLoggedIn(a.status)) fetchQr(a.alias);
    });
    setupCardEvents();
  }).catch(function() {
    document.getElementById('account-list').innerHTML =
      '<div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4"><p class="text-sm text-red-400">Failed to load accounts.</p></div>';
  });
}

function fetchQr(alias) {
  var wrap = document.querySelector('.acct-card[data-alias="' + alias + '"] .acct-qr-wrap');
  if (!wrap) return;
  WAOS.api('/api/accounts/' + alias + '/qr?t=' + Date.now()).then(function(data) {
    if (data.qr && typeof data.qr === 'string' && data.qr.length > 0) {
      wrap.innerHTML = '';
      var canvas = document.createElement('canvas');
      canvas.style.width = '240px';
      canvas.style.height = '240px';
      canvas.style.borderRadius = '12px';
      QRCode.toCanvas(canvas, data.qr, { width: 240, margin: 2, color: { dark: '#000000', light: '#ffffff' } }).catch(function() {
        wrap.innerHTML = '<div class="flex flex-col items-center gap-2 text-sm text-waos-warn justify-center py-3"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg><span>QR render error</span><button class="regen-icon text-xs px-2 py-1 mt-1 rounded border border-waos-warn text-waos-warn hover:bg-waos-warn/10 transition" data-regen="' + alias + '">Regenerate</button></div>';
        setupRegenButtons();
      });
      wrap.appendChild(canvas);
    } else {
      wrap.innerHTML = '<div class="flex flex-col items-center gap-2 text-sm text-waos-dim justify-center py-3"><svg class="w-8 h-8 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>No QR code available</span><button class="regen-icon text-xs px-2 py-1 mt-1 rounded border border-waos-warn text-waos-warn hover:bg-waos-warn/10 transition" data-regen="' + alias + '">Regenerate</button></div>';
      setupRegenButtons();
    }
  }).catch(function(err) {
    wrap.innerHTML = '<div class="flex flex-col items-center gap-2 text-sm text-waos-danger justify-center py-3"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Error: ' + (err.message || 'unknown') + '</span><button class="regen-icon text-xs px-2 py-1 mt-1 rounded border border-waos-warn text-waos-warn hover:bg-waos-warn/10 transition" data-regen="' + alias + '">Regenerate</button></div>';
    setupRegenButtons();
  });
}

function setupRegenButtons() {
  document.querySelectorAll('.regen-icon').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var alias = this.dataset.regen;
      if (!alias) return;
      if (confirm('This will clear the current session for "' + alias + '" and generate a new QR code. Continue?')) {
        WAOS.api('/api/accounts/' + alias + '/regenerate-qr', { method: 'POST' }).then(function() {
          setTimeout(function() { loadAccounts(); }, 500);
        }).catch(function(e) { alert(e.message); });
      }
    });
  });
}

function setupCardEvents() {
  document.querySelectorAll('.manage-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      renderManage(this.closest('.acct-card').dataset.alias);
    });
  });

  document.querySelectorAll('.pair-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var card = this.closest('.acct-card');
      var alias = card.dataset.alias;
      var inline = card.querySelector('.pair-inline');
      if (!inline.classList.contains('hidden')) {
        inline.classList.add('hidden');
        inline.querySelector('.pair-confirm-step').classList.remove('hidden');
        inline.querySelector('.pair-form-step').classList.add('hidden');
        return;
      }
      var warnEl = inline.querySelector('[id^="pair-warn-text-"]');
      if (warnEl) {
        var isLoggedIn = WAOS.isLoggedIn(card.dataset.status);
        warnEl.innerHTML = isLoggedIn
          ? 'This account is <strong>CURRENTLY LOGGED IN</strong>. Pairing will log it out and wipe credentials. Continue?'
          : 'This will initiate a pairing request for <strong>' + alias + '</strong>. Continue?';
      }
      inline.classList.remove('hidden');
    });
  });

  document.querySelectorAll('.pair-cancel').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inline = this.closest('.pair-inline');
      inline.classList.add('hidden');
      inline.querySelector('.pair-confirm-step').classList.remove('hidden');
      inline.querySelector('.pair-form-step').classList.add('hidden');
    });
  });

  document.querySelectorAll('.pair-continue').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inline = this.closest('.pair-inline');
      inline.querySelector('.pair-confirm-step').classList.add('hidden');
      inline.querySelector('.pair-form-step').classList.remove('hidden');
      inline.querySelector('.pair-phone').focus();
    });
  });

  document.querySelectorAll('.pair-submit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inline = this.closest('.pair-inline');
      var card = inline.closest('.acct-card');
      var alias = card.dataset.alias;
      var phoneInput = inline.querySelector('.pair-phone');
      var resultEl = inline.querySelector('.pair-result');
      var phone = phoneInput.value.trim().replace(/\D/g, '');
      if (!phone) { resultEl.textContent = 'Enter a phone number'; resultEl.className = 'text-xs text-waos-danger'; return; }
      resultEl.textContent = 'Sending...';
      resultEl.className = 'text-xs text-waos-dim';
      WAOS.api('/api/accounts/' + alias + '/pair', { method: 'POST', body: JSON.stringify({ phone: phone }) }).then(function(data) {
        resultEl.innerHTML = 'Code: <strong class="text-waos-accent">' + data.code + '</strong> — enter this on your phone.';
        resultEl.className = 'text-xs text-waos-text';
        phoneInput.value = '';
        var wrap = card.querySelector('.acct-qr-wrap');
        if (wrap) {
          wrap.innerHTML = '<div class="flex flex-col items-center gap-2 text-sm text-waos-info justify-center py-3"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg><span>Code: <strong>' + data.code + '</strong></span><span class="text-xs text-waos-dim">Enter this code on your phone</span></div>';
        }
      }).catch(function(e) {
        resultEl.textContent = e.message;
        resultEl.className = 'text-xs text-waos-danger';
      });
    });
  });
}

function renderManage(alias) {
  currentAlias = alias;
  document.getElementById('manage-title').textContent = alias;
  document.getElementById('manage-alias').textContent = alias;
  document.getElementById('manage-overlay').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  history.replaceState({ manage: alias }, '', '/accounts#' + alias);
  loadManageData(alias);
}

function loadManageData(alias) {
  var badgeEl = document.getElementById('manage-status-badge');
  var statusText = document.getElementById('manage-status-text');
  var errorEl = document.getElementById('manage-error');
  var phoneEl = document.getElementById('manage-phone');
  var logEl = document.getElementById('manage-log');
  var agentsContainer = document.getElementById('manage-agents');
  var agentsResult = document.getElementById('manage-agents-result');

    errorEl.classList.add('hidden');

  WAOS.api('/api/accounts/' + alias).then(function(data) {
    var status = data.status || 'unknown';
    badgeEl.innerHTML = statusHtml(status);
    statusText.textContent = status;
    phoneEl.textContent = data.phone || '(not set)';
    if (data.error) { errorEl.textContent = data.error; errorEl.classList.remove('hidden'); }

    renderBridgeToggles(
      data.bridge_dm_enabled !== false,
      data.bridge_group_enabled !== false
    );

    var currentAgents = (data.zeroclaw_agents || '').split(',').map(function(s) { return s.trim(); }).filter(Boolean);

    WAOS.api('/api/agents').then(function(agentData) {
      if (!agentData.agents || agentData.agents.length === 0) {
        agentsContainer.innerHTML = '<p class="text-xs text-waos-dim italic">No agents configured. <a href="/agents" class="text-waos-accent hover:underline">Add one</a>.</p>';
        return;
      }
      agentsContainer.innerHTML = agentData.agents.map(function(a) {
        var checked = currentAgents.indexOf(a.alias) !== -1 ? 'checked' : '';
        var desc = a.description ? '<span class="text-xs text-waos-dim ml-1">' + a.description + '</span>' : '';
        return '<label class="flex items-center gap-2 cursor-pointer group">' +
          '<input type="checkbox" class="agent-checkbox w-4 h-4 rounded border-waos-border bg-waos-bg text-waos-accent focus:ring-waos-accent cursor-pointer" data-alias="' + a.alias + '" ' + checked + '>' +
          '<span class="text-sm text-waos-text group-hover:text-waos-accent transition">' + a.alias + '</span>' +
          desc +
        '</label>';
      }).join('');

      document.querySelectorAll('.agent-checkbox').forEach(function(cb) {
        cb.addEventListener('change', function() {
          var checked = [];
          document.querySelectorAll('.agent-checkbox:checked').forEach(function(c) { checked.push(c.dataset.alias); });
          var agentsStr = checked.join(',');
          agentsResult.classList.remove('hidden', 'text-waos-accent', 'text-waos-danger');
          agentsResult.className = 'text-xs mt-2 text-waos-dim';
          agentsResult.textContent = 'Saving...';
          WAOS.api('/api/accounts/' + alias + '/agents', { method: 'PUT', body: JSON.stringify({ agents: agentsStr, bridge_dm_enabled: bridgeDmEnabled, bridge_group_enabled: bridgeGroupEnabled }) }).then(function() {
            agentsResult.textContent = 'Saved!';
            agentsResult.className = 'text-xs mt-2 text-waos-accent';
            setTimeout(function() { agentsResult.classList.add('hidden'); }, 2000);
          }).catch(function(e) {
            agentsResult.textContent = e.message;
            agentsResult.className = 'text-xs mt-2 text-waos-danger';
          });
        });
      });

      document.querySelectorAll('.bridge-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var key = this.dataset.key;
          var current = key === 'dm' ? bridgeDmEnabled : bridgeGroupEnabled;
          saveBridgeState(key, !current, alias);
        });
      });
    }).catch(function() {
      agentsContainer.innerHTML = '<p class="text-xs text-waos-danger">Failed to load agents.</p>';
    });
  }).catch(function() {
    badgeEl.innerHTML = statusHtml('unknown');
    statusText.textContent = 'unknown';
  });

  var events = WAOS.sseLog().filter(function(e) { return e.account === alias; }).slice(-30);
  logEl.innerHTML = events.length
    ? events.map(function(e) { return '<div class="text-waos-dim"><span class="text-waos-muted">' + new Date(e.time).toLocaleTimeString() + '</span> ' + e.type + (e.code ? ': ' + e.code : '') + '</div>'; }).join('')
    : '<p class="text-waos-dim italic">No recent events</p>';
}

function updateBadge(alias, status) {
  var card = document.querySelector('.acct-card[data-alias="' + alias + '"]');
  if (!card) return;
  card.dataset.status = status;
  var badgeArea = card.querySelector('.flex.items-center.gap-2');
  if (badgeArea) {
    badgeArea.innerHTML = '<span class="font-semibold text-sm">' + alias + '</span>' + statusHtml(status);
  }
  var wrap = card.querySelector('.acct-qr-wrap');
  if (wrap) {
    if (WAOS.isLoggedIn(status)) {
      wrap.innerHTML = '<div class="flex flex-col items-center gap-2 text-sm text-emerald-400 justify-center py-3"><svg class="w-8 h-8 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><span>Account already logged in</span></div>';
    } else {
      fetchQr(alias);
    }
  }
  if (currentAlias === alias) loadManageData(alias);
}

document.getElementById('create-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var alias = document.getElementById('alias').value.trim();
  var result = document.getElementById('create-result');
  result.classList.remove('hidden');
  result.className = 'text-xs mt-2 text-waos-dim';
  result.textContent = 'Creating...';

  WAOS.api('/api/accounts', { method: 'POST', body: JSON.stringify({ alias: alias }) }).then(function() {
    result.textContent = 'Account "' + alias + '" created!';
    result.className = 'text-xs mt-2 text-waos-accent';
    document.getElementById('alias').value = '';
    loadAccounts();
  }).catch(function(e) {
    result.textContent = e.message;
    result.className = 'text-xs mt-2 text-waos-danger';
  });
});

document.getElementById('regenerate-modal').addEventListener('click', function(e) {
  if (!e.target.matches('[data-modal-confirm]')) return;
  if (!currentAlias) return;
  document.getElementById('regenerate-modal').classList.add('hidden');
  document.getElementById('regenerate-modal').classList.remove('flex');

  WAOS.api('/api/accounts/' + currentAlias + '/regenerate-qr', { method: 'POST' }).then(function() {
    setTimeout(function() { loadAccounts(); }, 500);
  }).catch(function(e) { alert(e.message); });
});

document.getElementById('regenerate-qr-btn').addEventListener('click', function() {
  if (!currentAlias) return;
  var body = document.getElementById('regenerate-modal-body');
  body.textContent = 'This will clear the current session and credentials for "' + currentAlias + '". You will need to scan the new QR code to reconnect. Continue?';
  document.getElementById('regenerate-modal').classList.remove('hidden');
  document.getElementById('regenerate-modal').classList.add('flex');
});

document.getElementById('delete-modal').addEventListener('click', function(e) {
  if (!e.target.matches('[data-modal-confirm]')) return;
  if (!currentAlias) return;
  document.getElementById('delete-modal').classList.add('hidden');
  document.getElementById('delete-modal').classList.remove('flex');

  WAOS.api('/api/accounts/' + currentAlias, { method: 'DELETE' }).then(function() {
    closeManage();
    loadAccounts();
  }).catch(function(e) { alert(e.message); });
});

document.getElementById('delete-account-btn').addEventListener('click', function() {
  document.getElementById('delete-modal').classList.remove('hidden');
  document.getElementById('delete-modal').classList.add('flex');
});

var bridgeDmEnabled = true;
var bridgeGroupEnabled = true;

function renderBridgeToggle(key, enabled) {
  var toggle = document.querySelector('.bridge-toggle[data-key="' + key + '"]');
  if (!toggle) return;
  var labelId = key === 'dm' ? 'manage-bridge-dm-label' : 'manage-bridge-group-label';
  var label = document.getElementById(labelId);
  var track = toggle.querySelector('span:first-child');
  var thumb = toggle.querySelector('span:last-child');
  if (enabled) {
    track.className = 'absolute inset-0 rounded-full bg-waos-accent transition-colors';
    thumb.className = 'absolute top-0.5 left-[22px] w-5 h-5 rounded-full bg-white transition-transform shadow-sm';
    label.textContent = key === 'dm' ? 'Forwarding DMs to agents' : 'Forwarding group messages to agents';
  } else {
    track.className = 'absolute inset-0 rounded-full bg-waos-border transition-colors';
    thumb.className = 'absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-transform shadow-sm';
    label.textContent = key === 'dm' ? 'DM bridge paused' : 'Group bridge paused';
  }
  if (key === 'dm') bridgeDmEnabled = enabled;
  else bridgeGroupEnabled = enabled;
}

function renderBridgeToggles(dmEnabled, groupEnabled) {
  renderBridgeToggle('dm', dmEnabled);
  renderBridgeToggle('group', groupEnabled);
}

function saveBridgeState(key, newEnabled, alias) {
  var checked = [];
  document.querySelectorAll('.agent-checkbox:checked').forEach(function(c) { checked.push(c.dataset.alias); });
  var agentsStr = checked.join(',');
  var body = { agents: agentsStr };
  if (key === 'dm') body.bridge_dm_enabled = newEnabled;
  else body.bridge_group_enabled = newEnabled;
  var agentsResult = document.getElementById('manage-agents-result');
  agentsResult.classList.remove('hidden', 'text-waos-accent', 'text-waos-danger');
  agentsResult.className = 'text-xs mt-2 text-waos-dim';
  agentsResult.textContent = 'Saving...';
  WAOS.api('/api/accounts/' + alias + '/agents', { method: 'PUT', body: JSON.stringify(body) }).then(function() {
    renderBridgeToggle(key, newEnabled);
    agentsResult.textContent = 'Saved!';
    agentsResult.className = 'text-xs mt-2 text-waos-accent';
    setTimeout(function() { agentsResult.classList.add('hidden'); }, 2000);
  }).catch(function(e) {
    renderBridgeToggle(key, !newEnabled);
    agentsResult.textContent = e.message;
    agentsResult.className = 'text-xs mt-2 text-waos-danger';
  });
}

window.closeManage = function() {
  document.getElementById('manage-overlay').classList.add('hidden');
  document.body.style.overflow = '';
  currentAlias = null;
  history.replaceState({}, '', '/accounts');
};

if (location.hash) {
  var alias = location.hash.slice(1);
  setTimeout(function() { renderManage(alias); }, 500);
}

WAOS.sseOn('Connected', function(p) { updateBadge(p.account, 'connected'); });
WAOS.sseOn('Disconnected', function(p) { updateBadge(p.account, 'disconnected'); });
WAOS.sseOn('Reconnecting', function(p) { updateBadge(p.account, 'reconnecting'); });
WAOS.sseOn('AccountStatusUpdate', function(p) { updateBadge(p.account, p.status); });
WAOS.sseOn('QrCodeReady', function(p) { updateBadge(p.account, 'disconnected'); setTimeout(function() { fetchQr(p.account); }, 200); });
WAOS.sseOn('PairingCode', function(p) { updateBadge(p.account, 'pairing'); });
WAOS.sseOn('AccountTempBan', function(p) { updateBadge(p.account, 'banned'); });

WAOS.sseConnect();
loadAccounts();
document.getElementById('refresh-btn').addEventListener('click', loadAccounts);
</script>
